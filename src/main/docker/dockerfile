# Use the GraalVM Community JDK 21 as the base image
FROM ghcr.io/graalvm/jdk-community:21

# Install unzip and findutils using any available package manager
RUN if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache unzip findutils; \
    elif command -v yum >/dev/null 2>&1; then \
      yum install -y unzip findutils; \
    elif command -v microdnf >/dev/null 2>&1; then \
      microdnf install -y unzip findutils; \
    elif command -v apt-get >/dev/null 2>&1; then \
      apt-get update && apt-get install -y unzip findutils; \
    else \
      echo "No known package manager found. Cannot install unzip and findutils." && exit 1; \
    fi
# Set the working directory
WORKDIR /app

# Copy any ZIP file(s) from your loose package build folder into the image.
# This assumes that your ZIP file(s) are in target/loose-package.
COPY target/loose-package/*.zip /app/

# Dynamically extract each ZIP file and remove the ZIP(s) after extraction.
RUN for zip in *.zip; do \
      echo "Extracting $zip"; \
      unzip "$zip" -d /app/; \
    done && rm -f *.zip

# Look for the extracted directory that contains "-loose" in its name.
# If found, rename it to "loose_package" so that we have a known directory name.
RUN set -ex; \
    DIR=$(find . -maxdepth 1 -type d -name "*-loose" | head -n 1); \
    if [ -n "$DIR" ]; then \
       echo "Found loose package directory: $DIR"; \
       mv "$DIR" loose_package; \
    else \
       echo "No loose package directory found"; \
       exit 1; \
    fi

# Change working directory to the loose package directory.
WORKDIR /app/loose_package

# Ensure the Linux startup script is executable.
RUN chmod +x run.sh

# Expose the port your application listens on (adjust if needed).
EXPOSE 8080

# Run the startup script.
CMD ["./run.sh"]
